# Environment template for Smart Presentations.
#
# This file is the committed source of truth for the variable list and must stay
# in sync with `src/env.js` (t3-oss/env-nextjs validates every name below).
# `pnpm run doctor` reports which variables are actually set in your `.env`, by
# name only — it never prints a value. `pnpm preflight` is an alias for the same
# script. Bare `pnpm doctor` does NOT reach it: pnpm >= 10 has its own built-in
# `doctor` for the pnpm installation and built-ins win over package.json scripts.
#
# How to use:
#   cp .env.example .env   then fill in the [REQUIRED] lines.
#
# [REQUIRED]  declared without `.optional()` in src/env.js. `pnpm dev` and
#             `pnpm build` fail immediately while any of these is unset.
# [OPTIONAL]  declared with `.optional()` or a `.default()`. Unset only disables
#             the feature named in the comment; it never blocks start-up.
#
# Empty values are treated as unset (src/env.js sets `emptyStringAsUndefined:
# true`), so leaving a line as "" fails exactly like deleting the line — there is
# no silent half-configured state. Placeholders only: never commit a filled-in
# copy, `.env` is git-ignored.

# ── Clerk (authentication) ──────────────────────────────────────────
# Where: Clerk Dashboard -> API Keys.
# Why required: `src/proxy.ts` runs clerkMiddleware on every route and the root
# layout mounts <ClerkProvider>, so both keys are needed on the first request.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""   # [REQUIRED] pk_live_... / pk_test_...
CLERK_SECRET_KEY=""                    # [REQUIRED] sk_live_... / sk_test_...

# [OPTIONAL] Clerk Dashboard -> Webhooks -> Add Endpoint, URL
# <your-origin>/api/webhooks/clerk, subscribing to user.created, user.updated
# and user.deleted. The `whsec_...` signing secret is displayed in the Dashboard
# once, at endpoint creation; there is no Backend API endpoint that creates it.
# Without it POST /api/webhooks/clerk returns 500 and Clerk users are never
# synced into the Supabase `public.users` table.
CLERK_WEBHOOK_SECRET=""

# ── Database (required) ─────────────────────────────────────────────
# Where: Supabase Dashboard -> Project Settings -> Database -> Connection
# string. Shape:
#   postgresql://postgres.<project-ref>:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# MUST be the Supabase project host (db.<project-ref>.supabase.co, or the
# Session-mode pooler aws-0-<region>.pooler.supabase.com) and NOT a local
# Postgres container: supabase/migrations reference Supabase internals
# (auth.users, auth.uid(), storage.buckets, storage.foldername()), so
# `pnpm db:push` against vanilla Postgres aborts on the first user migration and
# every later one never runs. Kept left empty so a copy-paste fails loudly
# instead of silently connecting to the wrong host.
DATABASE_URL=""                        # [REQUIRED]

# ── Supabase (optional) ─────────────────────────────────────────────
# Where: Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL is validated as a URL, so leave it empty rather than
# inventing a placeholder hostname.
NEXT_PUBLIC_SUPABASE_URL=""            # [OPTIONAL] Project URL, https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # [OPTIONAL] anon / publishable key (browser-safe, RLS applies)
SUPABASE_SERVICE_ROLE_KEY=""           # [OPTIONAL] service_role key (server only, bypasses RLS)

# ── AI providers (optional, but the app is useless without one) ─────
# Without OPENAI_API_KEY every AI generation endpoint returns 400: no outlines,
# no slides, no images. Users can supply their own key in Settings instead.
OPENAI_API_KEY=""                      # [OPTIONAL] https://platform.openai.com/api-keys
TOGETHER_AI_API_KEY=""                 # [OPTIONAL] https://api.together.ai/settings/api-keys
PINECONE_API_KEY=""                    # [OPTIONAL] https://app.pinecone.io -> API Keys
TAVILY_API_KEY=""                      # [OPTIONAL] https://app.tavily.com/home (web search)

# ── Image / media search (optional) ─────────────────────────────────
UNSPLASH_ACCESS_KEY=""                 # [OPTIONAL] https://unsplash.com/developers
PIXABAY_API_KEY=""                     # [OPTIONAL] https://pixabay.com/api/docs/
GIPHY_API_KEY=""                       # [OPTIONAL] https://developers.giphy.com
PEXELS_API_KEY=""                      # [OPTIONAL] https://www.pexels.com/api/
GOOGLE_CUSTOM_SEARCH_API_KEY=""        # [OPTIONAL] Google Cloud -> APIs & Services -> Credentials
SEARCH_ENGINE_CX=""                    # [OPTIONAL] Programmable Search Engine search element ID

# ── File uploads (optional) ─────────────────────────────────────────
# Where: https://app.uploadthing.com -> API Keys.
# Without it browser uploads to /api/uploadthing fail signature verification.
# The server-side utapi.uploadFiles() paths used by the image routes keep working.
UPLOADTHING_TOKEN=""                   # [OPTIONAL]

# ── Encryption at rest (optional) ───────────────────────────────────
# Encrypts per-user OpenAI keys before storing them server-side.
# MUST decode to exactly 32 bytes; a 64-character hex string is also accepted.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes previously stored user keys undecryptable, so treat the
# value as permanent.
API_KEY_ENCRYPTION_MASTER_KEY=""        # [OPTIONAL]

# ── Error tracking (optional) ───────────────────────────────────────
# Where: Sentry -> Project -> Settings -> Client Keys -> DSN.
NEXT_PUBLIC_SENTRY_DSN=""              # [OPTIONAL] client-side DSN (exposed to the browser)
SENTRY_DSN=""                          # [OPTIONAL] server-side DSN

# ── Runtime (optional) ──────────────────────────────────────────────
# Valid values: development | test | production. Defaults to "development".
# `pnpm dev` / `pnpm build` set this themselves; only set it by hand in a
# container that does not (e.g. the Docker runtime stage).
NODE_ENV=""

# ── Escape hatch (not part of the validated schema) ─────────────────
# Read directly by src/env.js, not declared in the schema. Only the literal
# values "true" or "1" skip validation, and skipping hides exactly the missing
# required variables this template exists to surface. Leave it alone locally;
# CI may set it to "true" only for a build step that has no secrets available.
SKIP_ENV_VALIDATION=""