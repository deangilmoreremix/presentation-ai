# Clerk Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional: required if you wire up the /api/webhooks/clerk endpoint
# for user sync (e.g. provisioning Supabase rows on sign-up).
CLERK_WEBHOOK_SECRET=""

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Database (via Supabase)
DATABASE_URL=""

# OpenAI for text and image generation
OPENAI_API_KEY=""

# Used to encrypt user API keys at rest (if server storage enabled)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_MASTER_KEY=""

# Optional: External APIs
UNSPLASH_ACCESS_KEY=""
PIXABAY_API_KEY=""
GIPHY_API_KEY=""
PEXELS_API_KEY=""
TAVILY_API_KEY=""
TOGETHER_AI_API_KEY=""
PINECONE_API_KEY=""
GOOGLE_CUSTOM_SEARCH_API_KEY=""
SEARCH_ENGINE_CX=""

# Uploadthing (if used)
UPLOADTHING_TOKEN=""

# Stripe billing (optional — only needed for paid plans)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Get from https://dashboard.stripe.com/webhooks after creating a webhook
# pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Sentry error tracking (optional but recommended for production)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Set to true to skip env validation (not recommended for production)
SKIP_ENV_VALIDATION=false